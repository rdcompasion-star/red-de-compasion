generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ USUARIOS Y ROLES ============

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  VIEWER
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  passwordHash        String
  role                UserRole @default(STAFF)
  active              Boolean  @default(true)
  // permisos finos por modulo, ademas del rol base
  canViewConfidential Boolean  @default(false)
  canPublish          Boolean  @default(false)
  canExport           Boolean  @default(false)
  canDelete           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  auditLogs AuditLog[]
}

// ============ CATALOGOS CONFIGURABLES ============

model StatusOption {
  id       String  @id @default(cuid())
  code     String  @unique
  label    String
  colorHex String  @default("#6b7280")
  isSystem Boolean @default(false)
  order    Int     @default(0)
  active   Boolean @default(true)
}

model ExitTypeOption {
  id       String  @id @default(cuid())
  code     String  @unique
  label    String
  isSystem Boolean @default(false)
  order    Int     @default(0)
  active   Boolean @default(true)
}

enum EmploymentStatus {
  NO_TRABAJA
  BUSCA_EMPLEO
  TRABAJANDO
  INDEPENDIENTE
  ESTUDIANDO
  ESTUDIA_Y_TRABAJA
  OTRA
  NO_INFORMADO
}

enum NameVisibility {
  FULL
  FIRST_NAME
  INITIALS
  CODE
}

enum PhotoType {
  INGRESO
  EGRESO
  EVOLUCION
}

// ============ PERSONA (nucleo) ============

model Person {
  id                        String    @id @default(cuid())
  internalCode              String    @unique
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  archived                  Boolean   @default(false)
  archivedAt                DateTime?
  archivedById              String?
  deletedAt                 DateTime?

  currentStatusCode         String
  currentEmploymentStatus   EmploymentStatus @default(NO_INFORMADO)
  employmentStatusUpdatedAt DateTime?

  identity            PersonIdentity?
  publicSettings      PersonPublicSettings?
  consent             PersonConsent?
  entryInfo           PersonEntry?
  exitInfo            PersonExit?
  statusHistory       StatusHistoryEntry[]
  processStages       ProcessStage[]
  followUps           FollowUp[]
  photos              Photo[]
  documents           Document[]
  confidentialEntries ConfidentialEntry[]
  internalNotes       InternalNote[]
  auditLogs           AuditLog[]
}

// ---- PRIVADO: identificacion ----
model PersonIdentity {
  id       String @id @default(cuid())
  personId String @unique
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  nombres                    String
  apellidos                  String
  fechaNacimiento            DateTime?
  sexo                       String?
  rut                        String?
  nacionalidad               String?
  comuna                     String?
  region                     String?
  telefono                   String?
  correo                     String?
  direccion                  String?
  contactoEmergenciaNombre   String?
  contactoEmergenciaTelefono String?
  contactoEmergenciaRelacion String?
}

// ---- config de que se muestra publicamente ----
model PersonPublicSettings {
  id                       String         @id @default(cuid())
  personId                 String         @unique
  person                   Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  nameVisibility           NameVisibility @default(CODE)
  publicDisplayNameOverride String?
}

// ---- consentimiento de publicacion ----
model PersonConsent {
  id                      String    @id @default(cuid())
  personId                String    @unique
  person                  Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  allowPublicProfile      Boolean   @default(false)
  allowPhoto              Boolean   @default(false)
  allowName               Boolean   @default(false)
  allowAge                Boolean   @default(false)
  allowEntryYear           Boolean   @default(false)
  allowExitYear            Boolean   @default(false)
  allowReinsertionStatus  Boolean   @default(false)

  authorizedAt            DateTime?
  authorizedById          String?
  documentRef             String?
  revokedAt               DateTime?
  revokedById             String?
  notes                   String?
  updatedAt                DateTime  @updatedAt
}

// ---- ingreso ----
model PersonEntry {
  id               String   @id @default(cuid())
  personId         String   @unique
  person           Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  fechaIngreso     DateTime
  modalidadIngreso String?
  motivoDerivacion String?
  responsableId    String?
}

// ---- egreso ----
model PersonExit {
  id             String    @id @default(cuid())
  personId       String    @unique
  person         Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  fechaEgreso    DateTime?
  exitTypeCode   String?
  motivoEgreso   String?
  responsableId  String?
  observaciones  String?
}

// ---- historial de estados (nunca se sobrescribe) ----
model StatusHistoryEntry {
  id            String   @id @default(cuid())
  personId      String
  person        Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  statusCode    String
  customLabel   String?
  fecha         DateTime @default(now())
  responsableId String?
  observaciones String?
  createdAt     DateTime @default(now())
}

// ---- etapas del proceso ----
model ProcessStage {
  id            String    @id @default(cuid())
  personId      String
  person        Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  programa      String?
  etapa         String
  fechaInicio   DateTime
  fechaFin      DateTime?
  responsableId String?
  observaciones String?
}

// ---- seguimiento post-egreso ----
model FollowUp {
  id                        String    @id @default(cuid())
  personId                  String
  person                    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  fecha                     DateTime  @default(now())
  vivienda                  String?
  empleo                    EmploymentStatus?
  estudios                  String?
  redApoyo                  String?
  continuidadAcompanamiento String?
  observaciones             String?
  proximaRevision           DateTime?
  registradoPorId           String?
  createdAt                 DateTime  @default(now())
}

// ---- fotografias ----
model Photo {
  id               String    @id @default(cuid())
  personId         String
  person           Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  tipo             PhotoType
  fecha            DateTime  @default(now())
  descripcion      String?
  filePath         String
  publicAuthorized Boolean   @default(false)
  uploadedById     String?
  createdAt        DateTime  @default(now())
}

// ---- documentos privados ----
model Document {
  id            String   @id @default(cuid())
  personId      String
  person        Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  tipo          String
  nombreArchivo String
  filePath      String
  descripcion   String?
  uploadedById  String?
  createdAt     DateTime @default(now())
}

// ---- info confidencial (campos configurables) ----
model ConfidentialFieldDefinition {
  id        String  @id @default(cuid())
  key       String  @unique
  label     String
  fieldType String  @default("text")
  order     Int     @default(0)
  active    Boolean @default(true)
}

model ConfidentialEntry {
  id           String   @id @default(cuid())
  personId     String
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  fieldKey     String
  valor        String
  updatedById  String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([personId, fieldKey])
}

// ---- notas internas ----
model InternalNote {
  id              String   @id @default(cuid())
  personId        String
  person          Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  autorId         String?
  contenido       String
  fecha           DateTime @default(now())
  correctedFromId String?
  createdAt       DateTime @default(now())
}

// ---- auditoria ----
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  personId  String?
  person    Person?  @relation(fields: [personId], references: [id])

  action    String
  module    String
  field     String?
  oldValue  String?
  newValue  String?
  result    String   @default("success")
  createdAt DateTime @default(now())
}
