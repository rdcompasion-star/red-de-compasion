# Postgres (Neon). En Vercel: Storage -> Create Database -> Neon (te da esta variable automáticamente)
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Auth.js: genera uno con `npx auth secret` o `openssl rand -base64 32`
AUTH_SECRET="reemplaza-esto-por-un-valor-aleatorio-largo"

# Vercel Blob (fotos/documentos). En Vercel: Storage -> Create Database -> Blob (te da esta variable automáticamente)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Solo para el primer seed en producción (crea el Super Administrador inicial)
SEED_ADMIN_EMAIL="admin@tudominio.org"
SEED_ADMIN_PASSWORD="cambia-esta-contraseña"
